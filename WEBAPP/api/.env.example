# Flask / CORS
FLASK_APP=app
FLASK_ENV=development
CORS_ORIGINS=http://localhost:5173

# Databricks
DATABRICKS_HOST=#https://adb-################.#.azuredatabricks.net
# Recommended for local: use Databricks profile-based auth (OAuth or SP)
DATABRICKS_CONFIG_PROFILE=dev-all-api
# Optional when not using profile auth. If omitted, the app falls back to
# WEBAPP/databricks.yml sql_warehouse id in local development.
DATABRICKS_WAREHOUSE_ID=
# Optional explicit credential fallback (avoid if possible in local dev)
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Weekly Table
WEEK_TABLE_START=12:30
WEEK_TABLE_END=23:30
WEEK_TABLE_START_OFFSET=15
WEEK_TABLE_END_OFFSET=15
CHANNEL_ORDER=Rai 1,Rai 2,Rai 3,Rete 4,Canale 5,Italia 1,La7,Tv8,Nove
CHANNEL_ORDER_SIMULATION_DETAIL=Rete 4,Canale 5,Italia 1,La7,Tv8,Nove

# Simulations
SOSTITUZIONE_ENDPOINT=simulazione-sostituzione
SOSTITUZIONE_TIMEOUT_SECONDS=120
SPOSTAMENTO_ENDPOINT=simulazione-spostamento
SPOSTAMENTO_TIMEOUT_SECONDS=120
CANDIDATES_DURATION_OFFSET_MINUTES=15
MOCK_SIMULATION_SOSTITUZIONE_RESULT=false
MOCK_SIMULATION_SPOSTAMENTO_RESULT=false

# Scenarios
MAX_SIMULATIONS_PER_SCENARIO=3
COMPETITORS_SLOT_DURATION_MINUTES=60

# User Identity
ALLOW_UNVERIFIED_BEARER_IDENTITY=false
ENABLE_LOCAL_DEV_IDENTITY_FALLBACK=true
LOCAL_DEV_USER_EMAIL=localdev@test.it